{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "cd frontend && npm install",
  "functions": {
    "api/index.py": {
      "runtime": "@vercel/python@4.3.1",
      "maxDuration": 60,
      "excludeFiles": "{**/tests/**,**/test/**,**/*.pyi,**/__pycache__/**,**/*.pyc,**/*.md,**/*.rst,**/*.txt,**/LICENSE*,**/AUTHORS*,**/CHANGELOG*,**/*.c,**/*.h,**/*.cpp,**/*.hpp,**/include/**,**/numpy/_core/tests/**,**/numpy/_core/include/**,**/pandas/tests/**,**/pandas/io/formats/templates/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" }
  ]
}
